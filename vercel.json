{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/gemini/text.ts": { "maxDuration": 60 },
    "api/gemini/image.ts": { "maxDuration": 60 },
    "api/gemini/video.ts": { "maxDuration": 30 },
    "api/gemini/video/poll.ts": { "maxDuration": 60 },
    "api/voice/consolidate.ts": { "maxDuration": 60, "includeFiles": "node_modules/ffmpeg-static/ffmpeg" },
    "api/render/final.ts": { "maxDuration": 300, "includeFiles": "{node_modules/ffmpeg-static/ffmpeg,api/_lib/assets/**}" },
    "api/render/final/poll.ts": { "maxDuration": 60 },
    "api/cron/cleanup-gemini-videos.ts": { "maxDuration": 60 },
    "api/elevenlabs/text-to-speech.ts": { "maxDuration": 60 },
    "api/elevenlabs/speech-to-speech.ts": { "maxDuration": 60 },
    "api/elevenlabs/voices.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/cleanup-gemini-videos", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/billing/success", "destination": "/index.html" },
    { "source": "/billing/cancel", "destination": "/index.html" },
    { "source": "/billing/3ds-return", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" }
  ]
}
