# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.vite/

# Environment & secrets
.env
.env.local
.env.*.local
credentials.json
token.json

# WAT intermediates
.tmp/

# Claude scheduler transient lock (in-session cron state)
.claude/scheduled_tasks.lock

# Portable tools downloaded per-session (e.g. gh CLI via scripts/restore-gh-cli.ps1)
.tools/

# Playwright MCP output (snapshots, console logs)
.playwright-mcp/

# Playwright test runner output (boot/render smoke artifacts, HTML report)
test-results/
playwright-report/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

.vercel
public/mediapipe/wasm/

# Local screen recordings / scratch video dropped in repo root (smoke-test
# captures). Root-anchored so intentional videos in baselines/ demos/
# websiteinspodesigns/ stay trackable without `git add -f`.
/*.webm
/*.mp4
.env*

# code-review-graph local SQLite index — rebuildable in ~10s (`code-review-graph build`),
# wiped by the cafe-PC defreezer anyway. Never commit; see workflows/pr_review_loop.md.
.code-review-graph/

# Vercel CLI auth tokens — NEVER commit (restore-vercel.ps1 also refuses in-repo token files)
.vercel-token
vercel-token.txt

# Kuya Marvin ad edits — intermediates, rebuildable via ads/*/build-cut.sh
clients/oceanides/kuya-marvin/ads/*/edit/
# Hyperframes transparent intermediates — rebuildable from the committed HTML
clients/oceanides/kuya-marvin/ads/*/overlays/*.mov

# Preset Foundry artifact build output (rebuild: ads/build-preset-foundry.mjs)
.tmp/preset-foundry.html
.tmp/foundry-frame.jpg

# Kuya Gabriel ad edits — intermediates, rebuildable via ads/*/build-cut.sh
clients/oceanides/kuya-gabriel/ads/*/edit/

# Sentinel na pansamantalang pinapatulog ang ad-spend-gate.sh (tingnan ang hook).
# Hinding-hindi naka-commit: ang suspensyon ay dapat mamatay kasama ng makina.
.claude/.ad-spend-gate-suspended

# Tonight-only na permission grant para sa Meta Ads (tingnan ang comment sa loob).
# Local lang: dapat syang mamatay kasama ng makina, hindi mabuhay sa repo.
.claude/settings.local.json

# Pansamantalang hosting ng ad video para makuha ito ng Meta sa public URL.
# Hindi kailanman naka-commit: nasa clients/oceanides/ na ang totoong kopya.
funnels/oceanides-price-page/public/*.mp4
