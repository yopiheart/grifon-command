# Copy to .env and fill in real values. Never commit .env.

# --- AI / Generative ---
# Server-side keys used by api/* proxy routes. No VITE_ prefix.
GEMINI_API_KEY=
ELEVEN_LABS_API_KEY=

# Kling 3.0 video proxy (klingai.com Global region).
# Access Key + Secret Key pair from app.klingai.com/global/dev/api-key.
# Server-side only; the proxy at api/kling/video.ts signs a JWT per request.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Server-side gate for the voice cloning endpoint. Set to 'true' after
# upgrading ElevenLabs to Starter+ and verifying IVC end-to-end. While
# unset/false, POST /api/elevenlabs/voices returns 503 feature_disabled.
GRIFON_VOICE_CLONING_ENABLED=false

# --- Supabase (auth + DB) ---
# VITE_ prefixed values are exposed to the browser (safe: anon key respects RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only; never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=

# --- PayMongo (billing) ---
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Google OAuth (for Sheets/Drive/Slides) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- App config ---
APP_URL=https://app.grifon.ai
APP_ENV=development

# Dev-only: set to 'true' in your LOCAL .env to skip the monthly video_ads meter
# so smoke-testing the wizard end-to-end doesn't burn your real per-plan video cap
# (e.g. Pro = 15 renders/month). Server-side only; NEVER set this on Vercel — it is
# read by api/_lib/quota.ts consumeMonthly() and only bypasses the video meter.
# Absent under vitest, so the quota tests still assert the real cap.
GRIFON_DEV_UNMETERED_VIDEO=false
