# Copy to .env and fill in real values. Never commit .env.

# --- AI / Generative ---
# Server-side keys used by api/* proxy routes. No VITE_ prefix.
GEMINI_API_KEY=
ELEVEN_LABS_API_KEY=

# Server-side gate for the voice cloning endpoints. Set to 'true' after
# upgrading ElevenLabs to Starter+ and verifying IVC end-to-end. While
# unset/false, /api/elevenlabs/voices/clone returns 503 feature_disabled.
GRIFON_VOICE_CLONING_ENABLED=false

# --- Supabase (auth + DB) ---
# VITE_ prefixed values are exposed to the browser (safe: anon key respects RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only; never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=

# --- PayMongo (billing) ---
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Google OAuth (for Sheets/Drive/Slides) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- App config ---
APP_URL=https://app.grifon.ai
APP_ENV=development
