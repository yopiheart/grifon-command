# Copy to .env and fill in real values. Never commit .env.

# --- AI / Generative ---
# Server-side keys used by api/* proxy routes. No VITE_ prefix.
GEMINI_API_KEY=
ELEVEN_LABS_API_KEY=

# Kling 3.0 video proxy (klingai.com Global region).
# Access Key + Secret Key pair from app.klingai.com/global/dev/api-key.
# Server-side only; the proxy at api/kling/video.ts signs a JWT per request.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Server-side gate for the voice cloning endpoint. Set to 'true' after
# upgrading ElevenLabs to Starter+ and verifying IVC end-to-end. While
# unset/false, POST /api/elevenlabs/voices returns 503 feature_disabled.
GRIFON_VOICE_CLONING_ENABLED=false

# Server-side gate for generative music beds (ElevenLabs Music) in the render
# pipeline. Ships dark: while unset/false, POST /api/music/compose returns 503
# and renders fall back to the tuned static beds. Set to 'true' only AFTER the
# A/B listen test (tools/smoke_music_bed.py) confirms a generated bed >= the
# static beds, and the ElevenLabs commercial-use + cost gates are cleared.
GRIFON_MUSIC_GEN_ENABLED=false

# --- Supabase (auth + DB) ---
# VITE_ prefixed values are exposed to the browser (safe: anon key respects RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only; never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=

# --- Media store (rendered video + audio objects) ---
# MEDIA_STORE picks which bucket api/_lib/mediaStore.ts writes to and signs from:
#   'supabase' (code default) - the Supabase storage bucket.
#   'r2'                     - Cloudflare R2 via api/_lib/r2.ts (SigV4, aws4fetch).
# WARNING: PRODUCTION RUNS ON 'r2'. A finished run's artifacts.finalVideoUrl is an
# r2.cloudflarestorage.com URL, while the Supabase bucket holds only 4 stale July-2026
# smoke files. These keys were missing from this file until 2026-08-28, and their
# absence sent that session hunting for a finished render in the Supabase bucket, which
# reads as "the media is gone" while the objects sit in R2 untouched. All four R2_* are
# required TOGETHER - api/_lib/r2.ts throws
# R2_NOT_CONFIGURED if any one is missing. No VITE_ prefix: server-side only.
# NOTE: producer_runs / producer_scenes store PRESIGNED urls and those signatures
# expire. On an old clip, 403 = expired signature (the object is still there), 404 =
# really gone. scripts/resign-restitch-urls.mjs re-signs them; that difference is
# the difference between re-cutting for free and paying for a fresh render.
MEDIA_STORE=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Meta Pixel + Conversions API (Growth Loop Phase 0) ---
# Pixel ID is PUBLIC (client-side, safe to bundle). The CAPI access token is a
# SERVER-ONLY secret (no VITE_ prefix) read by api/_lib/metaCapi.ts.
VITE_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional while testing — copy from Events Manager > Test Events; remove for prod.
META_CAPI_TEST_EVENT_CODE=

# --- Meta Marketing/Insights API (Growth Loop Phase 2 — ad-performance ingest) ---
# Read by tools/meta_insights_pull.py to pull ad metrics into public.ad_performance.
# META_INSIGHTS_ACCESS_TOKEN needs the ads_read scope — a DIFFERENT token from the
# Phase-0 CAPI/Dataset token above. SERVER-ONLY; never commit, never VITE_-prefix.
# (Wire these only when an ad account is actually running Grifon ads; until then the
# tool runs with --fixture / --dry-run.)
META_AD_ACCOUNT_ID=
META_INSIGHTS_ACCESS_TOKEN=

# --- PayMongo (billing) ---
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Google OAuth (for Sheets/Drive/Slides) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Feature flags ---
# P4 scene-image gate. BOTH must be exactly 'true' to activate; either one absent
# or anything-but-'true' = fully dark (pre-P4 behavior, zero cost, zero meters).
#   IMAGE_GATE_ENABLED       server, runtime  — api/gemini/image.ts returns 503 when off.
#   VITE_IMAGE_GATE_ENABLED  client, BUILD-TIME — baked into the bundle by
#                            services/producerDeps.ts gateDepsFor. Changing it on Vercel
#                            does NOTHING until you REDEPLOY.
# ⚠ Asymmetric partial state: VITE_ on + server off wires the DETERMINISTIC
# checkSceneImage (which HARD-FLAGS scenes and drives the only automated reroll) while
# the AI gate 503s and silently skips. Set BOTH, or NEITHER.
IMAGE_GATE_ENABLED=false
VITE_IMAGE_GATE_ENABLED=false

# --- Pre-launch curtain (LaunchLock) ---
# VITE_LAUNCH_LOCK  client, BUILD-TIME — 'true' shows the invite-only lock IN PLACE
#                   OF the auth gateway. It gates /login, /app and /checkout only:
#                   the marketing site (landing, pricing, legal) stays fully
#                   browsable and every CTA still works, it just lands on the lock
#                   instead of sign-up. An already authenticated user is never
#                   locked out. Vite INLINES this into the bundle: flipping it on
#                   Vercel does NOTHING until you REDEPLOY.
# LAUNCH_INVITE_CODES  server, runtime — the codes that open the door. Comma,
#                   space, or newline separated; matching is case-insensitive and
#                   ignores anything outside A-Z 0-9 and dashes. Server-side ONLY
#                   (no VITE_ prefix) so codes never reach the browser bundle;
#                   revoke by editing this var and redeploying. Empty while the
#                   lock is on = POST /api/gate returns 503 gate_not_configured.
# Invite links: https://grifon.ai/i/FOUNDER-01  (or ?invite=FOUNDER-01) — the code
# redeems itself on arrival and is scrubbed from the address bar.
VITE_LAUNCH_LOCK=false
LAUNCH_INVITE_CODES=

# Seeded per-ad SFX variant rotation in the final render (api/_lib/renderFfmpeg.ts).
# Anything but 'true' = legacy static bank. CLASSIC never rotates regardless.
SFX_V2_ENABLED=false

# Splices mid-scene dead air (silence BETWEEN spoken words) out of the final
# render (api/_lib/voiceMidGap.ts). Anything but 'true' = today's behavior, no
# plan and no graph change. Gaps >=0.6s compress to a 0.15s floor, max 2 per
# scene; a `talking` scene loses the span from BOTH streams (a jump cut),
# `b-roll`/`cinematic` from the audio only. Ships dark pending Neil's eyeball on
# a real render (gate 5 of workflows/format_sample_readiness.md).
# ⚠ "Runtime-read" means process.env is read at CALL time (so tests can toggle
# per-case) — it does NOT mean a Vercel dashboard edit reaches a live function.
# Vercel bakes env into the deployment, so ANY change here needs a REDEPLOY
# before it affects production. Same for every server flag in this file.
MID_GAP_TRIM_ENABLED=false

# --- Omni Edit Styles (PARKED 2026-08-13 — see workflows/omni_edit_styles_plan.md) ---
# OMNI_STYLES_ENABLED  server, runtime — the KILL SWITCH, and it fails CLOSED.
#                   Anything but exactly 'true' makes api/gemini/omni-video.ts
#                   return 503 omni_styles_disabled BEFORE auth, meters, and the
#                   Gemini call, so a parked feature costs zero. Ads still ship
#                   FFmpeg-only; the picker hides via api/gemini/omni-video/status.ts.
#                   api/gemini/omni-video/consume.ts deliberately has NO check, so an
#                   in-flight pass can still settle its billing after a mid-pass flip.
# OMNI_STYLES_BETA_ALLOWLIST  server, runtime — cohort control, NOT a kill switch.
#                   ⚠ INVERTED vs every other flag here: unset/empty = OPEN TO
#                   EVERYONE (api/_lib/omniBeta.ts returns true). It only ever
#                   NARROWS an already-enabled feature to the listed emails/user ids.
#                   Never rely on it to turn Omni off — use OMNI_STYLES_ENABLED.
# Both must be favorable for a paid pass: status.ts computes `enabled && betaAllowed`.
# ⚠ Unrelated despite the name: api/kling/omni-video.ts is Kling O1 (the 2-frame
# morph hook model, base render path) and is NOT gated by these flags.
OMNI_STYLES_ENABLED=false
OMNI_STYLES_BETA_ALLOWLIST=

# --- App config ---
APP_URL=https://grifon.ai
APP_ENV=development

# Dev-only: set to 'true' in your LOCAL .env to skip the monthly video_ads meter
# so smoke-testing the wizard end-to-end doesn't burn your real per-plan video cap
# (e.g. Pro = 15 renders/month). Server-side only; NEVER set this on Vercel — it is
# read by api/_lib/quota.ts consumeMonthly() and only bypasses the video meter.
# Absent under vitest, so the quota tests still assert the real cap.
GRIFON_DEV_UNMETERED_VIDEO=false
