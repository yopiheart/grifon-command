# Copy to .env and fill in real values. Never commit .env.

# --- AI / Generative ---
# Server-side keys used by api/* proxy routes. No VITE_ prefix.
GEMINI_API_KEY=
ELEVEN_LABS_API_KEY=

# Kling 3.0 video proxy (klingai.com Global region).
# Access Key + Secret Key pair from app.klingai.com/global/dev/api-key.
# Server-side only; the proxy at api/kling/video.ts signs a JWT per request.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Server-side gate for the voice cloning endpoint. Set to 'true' after
# upgrading ElevenLabs to Starter+ and verifying IVC end-to-end. While
# unset/false, POST /api/elevenlabs/voices returns 503 feature_disabled.
GRIFON_VOICE_CLONING_ENABLED=false

# Server-side gate for generative music beds (ElevenLabs Music) in the render
# pipeline. Ships dark: while unset/false, POST /api/music/compose returns 503
# and renders fall back to the tuned static beds. Set to 'true' only AFTER the
# A/B listen test (tools/smoke_music_bed.py) confirms a generated bed >= the
# static beds, and the ElevenLabs commercial-use + cost gates are cleared.
GRIFON_MUSIC_GEN_ENABLED=false

# --- Supabase (auth + DB) ---
# VITE_ prefixed values are exposed to the browser (safe: anon key respects RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only; never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Pixel + Conversions API (Growth Loop Phase 0) ---
# Pixel ID is PUBLIC (client-side, safe to bundle). The CAPI access token is a
# SERVER-ONLY secret (no VITE_ prefix) read by api/_lib/metaCapi.ts.
VITE_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional while testing — copy from Events Manager > Test Events; remove for prod.
META_CAPI_TEST_EVENT_CODE=

# --- Meta Marketing/Insights API (Growth Loop Phase 2 — ad-performance ingest) ---
# Read by tools/meta_insights_pull.py to pull ad metrics into public.ad_performance.
# META_INSIGHTS_ACCESS_TOKEN needs the ads_read scope — a DIFFERENT token from the
# Phase-0 CAPI/Dataset token above. SERVER-ONLY; never commit, never VITE_-prefix.
# (Wire these only when an ad account is actually running Grifon ads; until then the
# tool runs with --fixture / --dry-run.)
META_AD_ACCOUNT_ID=
META_INSIGHTS_ACCESS_TOKEN=

# --- PayMongo (billing) ---
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Google OAuth (for Sheets/Drive/Slides) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- App config ---
APP_URL=https://grifon.ai
APP_ENV=development

# Dev-only: set to 'true' in your LOCAL .env to skip the monthly video_ads meter
# so smoke-testing the wizard end-to-end doesn't burn your real per-plan video cap
# (e.g. Pro = 15 renders/month). Server-side only; NEVER set this on Vercel — it is
# read by api/_lib/quota.ts consumeMonthly() and only bypasses the video meter.
# Absent under vitest, so the quota tests still assert the real cap.
GRIFON_DEV_UNMETERED_VIDEO=false
