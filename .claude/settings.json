{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "grep -qE '\"file_path\"[[:space:]]*:[[:space:]]*\"[^\"]*(/(api|services|components)/|\\\\\\\\(api|services|components)\\\\\\\\|/App\\.tsx|\\\\\\\\App\\.tsx)' && { mkdir -p .tmp && touch .tmp/.edits-this-turn; } || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f .tmp/.edits-this-turn ] && { rm -f .tmp/.edits-this-turn; printf '{\"systemMessage\":\"Edits touched api/services/components/App.tsx — run `npm test && npm run build` before declaring done.\"}\\n'; } || true"
          }
        ]
      }
    ]
  }
}
