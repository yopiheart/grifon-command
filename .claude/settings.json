{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -NonInteractive -File .claude\\statusline.ps1"
  },
  "permissions": {
    "comment": "Read-only inspection + the verify-changes build/test commands are pre-approved so they never prompt. Survives the cafe-PC defreezer because it lives in the repo. Deliberately omits git commit/push and rm — CLAUDE.md says commit only when asked, so those stay prompt-gated.",
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test:watch)",
      "Bash(npm run design:lint)",
      "Bash(npm run design:tailwind)",
      "Bash(npm run design:spec)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "grep -qE '\"file_path\"[[:space:]]*:[[:space:]]*\"[^\"]*(/(api|services|components)/|\\\\\\\\(api|services|components)\\\\\\\\|/App\\.tsx|\\\\\\\\App\\.tsx)' && { mkdir -p .tmp && touch .tmp/.edits-this-turn; } || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash .claude/hooks/build-gate.sh"
          }
        ]
      }
    ]
  }
}
