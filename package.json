{
  "name": "creative-director-ai-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "//engines": "Pinned 2026-08-07. The cafe PC runs Node 24 / npm 11, CI ran Node 20 / npm 10, and npm 11 deterministically DROPS the nested optional-peer @types/react record that npm 10 requires. That divergence — not any API balance — is what broke every workflow from 2026-08-04 (commit 323da07 synced the lock to npm 11 and CI's npm 10 rejected it). CI is now on 24 too; keep both sides here so it cannot drift back silently.",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:ps1-ascii",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle-leak": "node tools/check-bundle-leak.mjs",
    "check:voice-sync": "node tools/check-voice-lint-sync.mjs",
    "check:domain": "node tools/check-domain-language.mjs",
    "cost:estimate": "node tools/render_cost_estimate.mjs",
    "creative:batch": "node tools/batch-creative-codex.mjs",
    "design:lint": "design.md lint DESIGN.md",
    "design:tailwind": "design.md export --format tailwind DESIGN.md > design.tokens.json",
    "design:spec": "design.md spec",
    "check:ps1-ascii": "node tools/check-ps1-ascii.mjs",
    "check:artifact-anchors": "node tools/artifacts/build-eli5-image-gate.mjs && git diff --exit-code artifacts/eli5-image-gate.html"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@supabase/supabase-js": "^2.103.3",
    "@vercel/functions": "^3.6.2",
    "aws4fetch": "^1.0.20",
    "ffmpeg-static": "5.2.0",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@google/design.md": "0.1.1",
    "@playwright/test": "^1.61.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vercel/node": "^5.7.15",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "postcss": "^8.4.32",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
