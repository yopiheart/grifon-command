*{box-sizing:border-box}html,body{margin:0;width:1920px;height:1080px;overflow:hidden;background:#09090B}
#film{position:relative;width:1920px;height:1080px;overflow:hidden;font-family:Inter,sans-serif;background:#09090B}
#field,#cream-sheet,#world,.layer{position:absolute;inset:0;width:1920px;height:1080px}#world{pointer-events:none}.layer{visibility:hidden;pointer-events:none}#cream-sheet{background:#F2F1EC;visibility:hidden}
#field{background:#F2F1EC}.paper{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 44%,#ffffff22,transparent 75%);pointer-events:none}
.typed{position:absolute;left:0;top:449px;width:1920px;height:170px;text-align:center;font-size:110px;line-height:1.2;font-weight:400;letter-spacing:-5px;white-space:pre;color:#171b19}
.typed-line{display:inline-block;position:relative}.typed-letter{opacity:0}.cursor{display:inline-block;width:3px;height:.83em;background:currentColor;vertical-align:-.03em;margin-left:9px}
.collage-track{position:absolute;inset:0;transform-origin:center}.collage-word{position:absolute;font-size:112px;line-height:1.12;letter-spacing:-5.5px;font-weight:400;color:#171b19;white-space:nowrap}
.collage-word:last-child{font-weight:600;letter-spacing:-6px}.spark{position:absolute;left:918px;top:487px;width:77px;height:77px;fill:#171b19}
.hero-tag{position:absolute;left:1310px;top:110px;max-width:510px;padding:22px 28px;border:1.4px solid #f3f8eb88;border-radius:22px;background:linear-gradient(145deg,#213e51e8,#325767d9);font-size:43px;line-height:1.2;letter-spacing:-1px;font-weight:400;color:#fffef3;box-shadow:inset 0 1px #ffffff30}
.hero-tag:before{content:'';display:inline-block;width:8px;height:8px;border-radius:50%;background:#edf6db;margin:0 13px 5px 0}
#problem .collage-word{font-size:106px;letter-spacing:-5px}#problem .collage-word:last-child{font-weight:600}
#turn .typed{font-size:117px;color:#fff9e6;letter-spacing:-5px}
