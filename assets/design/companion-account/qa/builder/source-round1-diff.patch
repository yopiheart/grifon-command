+        {actionError && <p role="alert" className="text-sm leading-relaxed text-zinc-300">{actionError}</p>}
+        <p className="text-center text-sm text-zinc-400">Grifon Command © 2026</p>
+      </div>
+    </div>
+  </div>, document.body);
 };

 export default SettingsModal;
